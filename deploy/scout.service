# Scout as a systemd service, with Litestream restoring state before start and replicating it while running.
# Install: copy to /etc/systemd/system/, set WorkingDirectory and the paths, then `systemctl enable --now scout`.
[Unit]
Description=Scout
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=scout
WorkingDirectory=/opt/scout
EnvironmentFile=/opt/scout/.env
Environment=SCOUT_DATA_DIR=/var/lib/scout
# Secrets can come from systemd credentials instead of the environment file (see docs/operations.md):
# LoadCredential=slack-bot-token:/etc/scout/credentials/slack-bot-token
ExecStartPre=/usr/bin/litestream restore -config /opt/scout/deploy/litestream.yml -if-db-not-exists -if-replica-exists /var/lib/scout/pi.sqlite
ExecStartPre=/usr/bin/litestream restore -config /opt/scout/deploy/litestream.yml -if-db-not-exists -if-replica-exists /var/lib/scout/scout.sqlite
ExecStart=/usr/bin/litestream replicate -config /opt/scout/deploy/litestream.yml -exec "/usr/bin/node src/main.ts"
# Litestream passes on SIGINT and SIGTERM only, so other signals (HUP: read secrets again; USR2: reflect now) go to
# Scout's node process, Litestream's child: `kill -HUP $(pgrep -P $(systemctl show -p MainPID --value scout) -f src/main.ts)`.
# SIGTERM to Litestream alone (KillMode=mixed), which passes it on once: sent to every process (the default), Scout can
# get it twice, and a second signal stops Scout at once instead of cleanly.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
# Always: a drain for a deploy (scripts/deploy.sh, SIGINT to Scout) ends with Scout stopping cleanly, and systemd
# starts it again on the new code.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
