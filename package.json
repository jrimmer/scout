{
  "name": "scout",
  "version": "1.0.0",
  "description": "A public, multiplayer coding teammate that lives in Slack.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test --test-timeout=120000 'test/**/*.test.ts'",
    "check": "tsc --noEmit",
    "job": "node --env-file-if-exists=.env src/job.ts",
    "eval": "node --env-file-if-exists=.env src/eval-cli.ts",
    "bench": "node --env-file-if-exists=.env src/bench-cli.ts",
    "doctor": "node --env-file-if-exists=.env src/doctor-cli.ts",
    "dash-password": "node src/dash/server.ts",
    "audit": "node --env-file-if-exists=.env src/audit.ts",
    "pi": "scripts/pi.sh",
    "deploy": "scripts/deploy.sh"
  },
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-env": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "BSD-3-Clause"
}
