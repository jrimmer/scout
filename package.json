{
  "name": "scout",
  "version": "0.1.0",
  "description": "A public, multiplayer coding teammate that lives in Slack.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "tsc --noEmit",
    "job": "node --env-file-if-exists=.env src/job.ts",
    "dash-password": "node src/dash/server.ts"
  },
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
