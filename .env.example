# Slack (see slack-manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Model: provider/modelId. The provider reads its own key (ANTHROPIC_API_KEY, OPENAI_API_KEY).
SCOUT_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# The repository Scout works on. The host clones and pushes with its own git credentials (ssh agent);
# the sandbox never gets them.
SCOUT_REPO_URL=ssh://git@git.example.com/team/repo.git
SCOUT_REPO_SLUG=team/repo
SCOUT_REPO_BASE=main

# Code host for pull requests: forgejo (Gitea API) or github
SCOUT_CODEHOST=forgejo
SCOUT_CODEHOST_API=https://git.example.com/api/v1
SCOUT_CODEHOST_TOKEN=

# Optional
# SCOUT_DATA_DIR=data
# SCOUT_PROFILE_DIR=profile
# SCOUT_SANDBOX_IMAGE=scout-sandbox:latest
# SCOUT_SANDBOX_NETWORK=none      # a docker network name, e.g. bridge, if commands need to download dependencies
# SCOUT_SANDBOX_MEMORY=4g
# SCOUT_GIT_NAME=Scout
# SCOUT_GIT_EMAIL=scout@localhost
