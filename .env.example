# Slack (see slack-manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Model: provider/modelId. The provider reads its own key (ANTHROPIC_API_KEY, OPENAI_API_KEY).
SCOUT_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# The repository Scout works on. The host clones and pushes with its own git credentials (ssh agent);
# the sandbox never gets them.
SCOUT_REPO_URL=ssh://git@git.example.com/team/repo.git
SCOUT_REPO_SLUG=team/repo
SCOUT_REPO_BASE=main
# More repositories, for channels whose profile names one (repo: in channels/<name>/instructions.md):
# SCOUT_REPOS_FILE=repos.json      # [{ "name": "storefront", "gitUrl": "ssh://…", "slug": "team/storefront", "base": "main",
#                                 #    "image": "scout-sandbox-storefront" }]   (image: optional, its own toolchain)
# SCOUT_REPO_NAME=api              # the default repository's name; defaults to the last part of its slug

# Give Scout its own code host account: its own token below and its own SSH key, with access to the repos it
# works on. Then its pull requests are its own, people review them like anyone else's, and you can revoke it
# without touching your access. With your personal token and key, Scout's work looks like yours.
# SCOUT_GIT_SSH_KEY=~/.ssh/scout_ed25519

# Code host for pull requests: forgejo (Gitea API) or github
SCOUT_CODEHOST=forgejo
SCOUT_CODEHOST_API=https://git.example.com/api/v1
SCOUT_CODEHOST_TOKEN=

# The learning loop. Make SCOUT_PROFILE_DIR a clone of a profile repository (start one from profile/ here):
# Scout keeps it pulled, and every night proposes changes to it from what happened in its threads.
# SCOUT_PROFILE_REPO_URL=ssh://git@git.example.com/team/scout-profile.git
# SCOUT_PROFILE_REPO_SLUG=team/scout-profile
# SCOUT_PROFILE_REPO_BASE=main
# SCOUT_PROFILE_DIR=profile-live
# SCOUT_REFLECT_HOUR=3              # local hour; `kill -USR2 <pid>` reflects now
# SCOUT_REFLECT_CHANNEL=#scout      # Scout's home channel: review requests for its proposals, weekly merge rate

# Tools beyond code: MCP servers (data warehouse, traces, CI…). They run on this host with their own credentials,
# never in a thread's sandbox, and can be limited to some channels. See src/mcp.ts for the file's shape.
# SCOUT_MCP_FILE=mcp.json

# Automation: pull requests with this label get a review comment from Scout, once per commit.
# SCOUT_REVIEW_LABEL=scout-review

# The dashboard: read-only, live. Loopback by default; any other address needs a password.
# SCOUT_DASH_ADDR=127.0.0.1:8893    # or off
# SCOUT_DASH_USER=ops
# SCOUT_DASH_PASSWORD_HASH=         # npm run dash-password -- '<password>'

# Sandboxes (docs/operations.md): docker (default), spoond, or local (no isolation)
# SCOUT_SANDBOX_DRIVER=docker
# SCOUT_SPOOND_URL=https://spoond.lan:8890
# SCOUT_SPOOND_TOKEN=
# SCOUT_SANDBOX_SIZE=4g             # docker: memory; spoond: small, medium, large, xlarge
# SCOUT_REPO_EGRESS=registry.npmjs.org,proxy.golang.org   # hosts the default repo's sandboxes may reach (spoond)
# SCOUT_REPO_SNAPSHOT=scout/node24  # spoond: a named snapshot the default repo's threads start from (toolchain, caches)

# Model calls through a gateway (Bifrost, LiteLLM, …)
# SCOUT_GATEWAY_URL=https://bifrost.lan/anthropic
# SCOUT_GATEWAY_KEY=
# SCOUT_GATEWAY_HEADERS={"x-bf-vk":"scout"}
# Models only the gateway knows: SCOUT_MODEL=gateway/<the gateway's name>, with SCOUT_GATEWAY_URL its OpenAI base
# (e.g. https://bifrost.lan/v1). SCOUT_GATEWAY_MODELS lists more, for channels' profiles.
# SCOUT_MODEL=gateway/lunaroute/deepseek-4.1-flash
# SCOUT_GATEWAY_MODELS=lunaroute/glm-5.3

# Telemetry: OTLP traces and a Prometheus /metrics on the dashboard listener
# SCOUT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# SCOUT_OTLP_HEADERS={"authorization":"Bearer …"}
# SCOUT_METRICS_TOKEN=

# Governance (docs/operations.md)
# SCOUT_REQUESTER_CHECK=enforce     # only people who can change a repository may ask for work in it
# SCOUT_PEOPLE_FILE=people.json     # { "U0123ABC": "alice" }: Slack user ID → code host login
# SCOUT_ALLOWED_USERGROUP=S0123     # only this Slack user group may ask
# SCOUT_LIMITS_FILE=limits.json     # weekly budgets, per-run limits, concurrency
# SCOUT_PRICES_FILE=prices.json     # local model prices, dollars per million tokens
# SCOUT_RETENTION_DAYS=90           # delete what quiet threads leave behind; the audit trail stays

# Secrets can be references: NAME_FILE=/path, NAME=file:/path, NAME=cred:name (systemd), NAME=op://vault/item/field.
# kill -HUP <pid> reads them again.

# Optional
# SCOUT_PR_MAX_LINES=1000         # biggest change (lines added + removed) Scout puts in one pull request
# SCOUT_DATA_DIR=data
# SCOUT_PI_MIGRATE=1              # once, to let Pi Durable from main convert pi.sqlite (see docs/operations.md)
# SCOUT_SANDBOX_IMAGE=scout-sandbox:latest
# SCOUT_SANDBOX_NETWORK=none      # or open (the internet); per-repository egress lists where the driver allows
# SCOUT_DOCKER_NETWORK=bridge     # the docker network "open" means
# SCOUT_GIT_NAME=Scout
# SCOUT_GIT_EMAIL=scout@localhost
